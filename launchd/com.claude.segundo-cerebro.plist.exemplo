<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.claude.segundo-cerebro</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Users/SEU_USUARIO/.claude/scripts/segundo-cerebro.py</string>
		<string>atualizar</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>WatchPaths</key>
	<array>
		<string>/Users/SEU_USUARIO/.claude/projects/-Users-SEU-USUARIO/memory</string>
	</array>
	<key>ThrottleInterval</key>
	<integer>120</integer>
	<key>StandardOutPath</key>
	<string>/Users/SEU_USUARIO/.claude/logs/segundo-cerebro.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/SEU_USUARIO/.claude/logs/segundo-cerebro.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
